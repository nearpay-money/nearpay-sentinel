{
  "name": "nearpay-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "NearPay sentinel: deposit-instruction co-signing, independent settlement audit, global kill switch.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "coverage": "vitest run --project unit --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm test:integration && pnpm build"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@nearpay-internal/auth": "0.2.0",
    "@nearpay-internal/bus": "0.2.0",
    "@nearpay-internal/chains": "0.2.0",
    "@nearpay-internal/db": "0.2.0",
    "@nearpay-internal/http": "0.2.0",
    "@nearpay-internal/ids": "0.2.0",
    "@nearpay-internal/intents": "0.2.0",
    "@nearpay-internal/money": "0.2.0",
    "@nearpay-internal/service": "0.2.0",
    "@nearpay-internal/spec": "0.2.1",
    "@nearpay/spec": "0.2.1",
    "bs58": "6.0.0",
    "canonicalize": "5.1.0",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@nearpay-internal/testing": "0.2.0",
    "@noble/curves": "2.4.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "fast-check": "4.10.2",
    "testcontainers": "11.14.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@nearpay/spec": "0.2.1",
      "@nearpay-internal/spec": "0.2.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "cpu-features",
      "ssh2",
      "protobufjs"
    ]
  }
}
